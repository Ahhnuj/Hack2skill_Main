# Anthropic Claude (optional — demo mode works without this)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase cloud sync
SUPABASE_URL=https://your-project-id.supabase.co

# Use ONE of these keys (server-side only — never prefix service role with NEXT_PUBLIC_):
SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

NEXT_PUBLIC_SUPABASE_ENABLED=true
